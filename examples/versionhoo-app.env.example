VERSIONHOO_APP_ID=12345
VERSIONHOO_PRIVATE_KEY_PATH=/run/secrets/versionhoo-app.pem
VERSIONHOO_WEBHOOK_SECRET=replace-with-a-long-random-secret
VERSIONHOO_TRUSTED_GITHUB_API_URLS=
VERSIONHOO_TRUSTED_GITHUB_CLONE_HOSTS=
VERSIONHOO_WEBHOOK_MAX_BODY_BYTES=1048576
VERSIONHOO_ALLOWED_REPOS=openhoo/hooversion,openhoo/mouserhoo
VERSIONHOO_RELEASE_BRANCHES=main
VERSIONHOO_CI_WORKFLOWS=CI
VERSIONHOO_PORT=3000
